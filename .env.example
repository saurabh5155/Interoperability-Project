# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interop_db
POSTGRES_USER=interop_user
POSTGRES_PASSWORD=changeme_strong_password

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password

# ─── MongoDB ────────────────────────────────────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=interop_history
MONGO_USER=interop_mongo
MONGO_PASSWORD=changeme_mongo_password

# ─── Kafka ──────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── Anthropic / Claude AI ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# ─── Security ───────────────────────────────────────────────────────────────
JWT_SECRET=your-256-bit-secret-here-minimum-32-chars
JWT_EXPIRATION_MS=86400000
AES_ENCRYPTION_KEY=your-32-byte-aes-key-for-credentials
ADMIN_API_KEY=admin-secret-api-key-changeme

# ─── Services (internal) ────────────────────────────────────────────────────
EHR_REGISTRATION_SERVICE_URL=http://localhost:8081
SUBSCRIPTION_SERVICE_URL=http://localhost:8082
ROUTING_ENGINE_URL=http://localhost:8083
DYNAMIC_ADAPTER_SERVICE_URL=http://localhost:8084
MAPPING_SERVICE_URL=http://localhost:8085
FHIR_CANONICAL_SERVICE_URL=http://localhost:8086
CONTEXT_RESOLVER_SERVICE_URL=http://localhost:8087
VALIDATION_SERVICE_URL=http://localhost:8088
AUDIT_SERVICE_URL=http://localhost:8089

# ─── FHIR ───────────────────────────────────────────────────────────────────
FHIR_VERSION=R4
FHIR_SERVER_BASE_URL=http://localhost:8086/fhir

# ─── Resilience ─────────────────────────────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_RATE=50
CIRCUIT_BREAKER_WAIT_DURATION_MS=60000
RETRY_MAX_ATTEMPTS=3
RETRY_WAIT_DURATION_MS=2000

# ─── Observability ──────────────────────────────────────────────────────────
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
OTEL_EXPORTER_ENDPOINT=http://localhost:4318
